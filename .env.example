# 자농(JANONG) 환경변수 설정 예시
# 이 파일을 .env 로 복사 후 실제 키 입력

# ──────────────────────────────────────────────
# Gemini API (작물 분석·병해충 진단)
# 발급: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────
# 농촌진흥청 농업기상 상세 관측데이터 API (V4)
# 발급: https://www.data.go.kr
# 서비스명: 농촌진흥청 국립농업과학원 농업기상 상세 관측데이터 조회
# ──────────────────────────────────────────────
VITE_NONGSA_API_KEY=your_nongsa_api_key_here

# ──────────────────────────────────────────────
# 기본 관측지점 코드 (앱 설정에서도 변경 가능)
# 형식: 482841A001 (양주시 은현면 — 장흥 인근 최근접)
# 코드 확인: data.go.kr → 농업기상 관측지점 기본정보 파일
# ──────────────────────────────────────────────
VITE_WEATHER_STATION_CODE=482841A001
